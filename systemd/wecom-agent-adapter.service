[Unit]
Description=Example agent queue adapter
After=wecom-app-callback.service wecom-kf-bridge.service

[Service]
Type=simple
User=wecom-bridge
Group=wecom-bridge
WorkingDirectory=/opt/wecom-companion-guide/code
EnvironmentFile=/etc/wecom-agent.env
ExecStart=/opt/wecom-companion-guide/.venv/bin/python bot_loop.py
Restart=always
RestartSec=3
UMask=0077
StateDirectory=wecom-agent
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wecom-agent

[Install]
WantedBy=multi-user.target
