# Copy to /etc/wecom-agent.env, fill real values, then chmod 600.
WECOM_CORP_ID=ww_example
WECOM_AGENT_ID=1000002
WECOM_APP_SECRET=replace_me
WECOM_CALLBACK_TOKEN=replace_with_high_entropy_text
WECOM_ENCODING_AES_KEY=replace_with_43_character_key

# Bind callback locally; expose it through Cloudflare Tunnel or a reverse proxy.
WECOM_BIND_HOST=127.0.0.1
WECOM_PORT=8765
# Optional exact trusted-domain verification file downloaded from WeCom.
# WECOM_VERIFY_FILE=/etc/wecom-agent/WW_verify_example.txt
WECOM_DATA_DIR=/var/lib/wecom-agent
WECOM_QUEUE_DIR=/var/lib/wecom-agent/queue
WECOM_STATE_DB=/var/lib/wecom-agent/state.sqlite3

# Required outbound allowlist. Comma-separate multiple enterprise UserIDs.
WECOM_ALLOWED_USER_IDS=user_example

# Optional second entrance: WeChat Customer Service. Authorize this same
# self-built application in the Customer Service API page before using kf/*.
WECOM_OPEN_KFID=wk_example
# Replace with the intended customer. An empty value binds the first authenticated customer.
WECOM_KF_EXTERNAL_USER_ID=wm_example
WECOM_ROUTE_AGENT=agent_default
WECOM_KF_POLL_SECONDS=15
WECOM_KF_TEXT_BYTES=2000
WECOM_MAX_MEDIA_BYTES=26214400

# Minimal adapter only. The command reads one route-envelope JSON object on stdin
# and writes one plain-text reply on stdout.
AGENT_COMMAND="/opt/wecom-companion-guide/.venv/bin/python /opt/wecom-companion-guide/code/example_agent.py"
AGENT_TIMEOUT_SECONDS=300

# Optional mini app: a token-scoped observation page opened from the WeCom
# application's home page, bottom menu and a textcard (guide/迷你应用.md).
# Generate the token with: openssl rand -hex 24
MINI_APP_TOKEN=replace_with_high_entropy_text
MINI_APP_BIND_HOST=127.0.0.1
MINI_APP_PORT=8766
# Public URL of the page, token included; written into WeCom by code/mini_app_setup.sh.
MINI_APP_PAGE_URL=https://bot.example.com/mini?k=replace_with_high_entropy_text
# Member account that receives the textcard (must be inside WECOM_ALLOWED_USER_IDS).
WECOM_TARGET_USER_ID=user_example
MINI_APP_MENU_NAME=面板
